# ---------------------------------------------------------------------------
# Tour guide marketplace — copy to .env (root) and services/api/.env
# ---------------------------------------------------------------------------

# --- Postgres (docker-compose) ---
POSTGRES_USER=tourguide
POSTGRES_PASSWORD=tourguide
POSTGRES_DB=tourguide
POSTGRES_PORT=5432

# --- API (services/api) ---
PORT=3000
DATABASE_URL=postgres://tourguide:tourguide@localhost:5432/tourguide
# Run pending migrations when the API boots
DB_RUN_MIGRATIONS=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3001

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev only: include the OTP code in the /auth/otp/request response
OTP_DEV_ECHO=true

# Pluggable providers (only "stub" is implemented in phase 1)
SMS_PROVIDER=stub
PAYMENT_PROVIDER=stub
KYC_PROVIDER=stub
AI_PROVIDER=stub

# Marketplace
PLATFORM_FEE_PERCENT=15
REVIEW_WINDOW_DAYS=30
DISPUTE_WINDOW_DAYS=7

# --- Admin portal (apps/admin) ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# --- Mobile (apps/mobile) — pass with --dart-define=API_URL=... ---
# Android emulator: http://10.0.2.2:3000/api  iOS simulator: http://localhost:3000/api
