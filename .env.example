# ---------------------------------------------------------------------------
# Tour guide marketplace — copy to .env (root) and services/api/.env
# ---------------------------------------------------------------------------

# --- Postgres (docker-compose) ---
POSTGRES_USER=tourguide
POSTGRES_PASSWORD=tourguide
POSTGRES_DB=tourguide
POSTGRES_PORT=5432

# --- API (services/api) ---
# production turns on the startup config check (refuses dev secrets / stub
# providers), disables Swagger and never echoes OTP codes.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://tourguide:tourguide@localhost:5432/tourguide
# Run pending migrations when the API boots
DB_RUN_MIGRATIONS=true
# At least 32 random characters in production: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
# Short-lived access tokens; the apps renew them with rotating refresh tokens.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3001

# Security
LOGIN_MAX_ATTEMPTS=5        # failed passwords before the account is locked
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT=10         # login requests per minute per IP
REGISTER_RATE_LIMIT=5       # sign-ups per minute per IP
# Behind a load balancer / reverse proxy: trust X-Forwarded-For for client IPs
TRUST_PROXY=false
# json = one JSON object per log line (for log shippers); text for local dev
LOG_FORMAT=text
# Serve /api/docs in production too (always on outside production)
ENABLE_SWAGGER=false
# Claude assistant messages per user (or IP) per day
ASSISTANT_DAILY_LIMIT=100
# The seed wipes data; it refuses NODE_ENV=production unless this is "yes"
# SEED_ALLOW_PRODUCTION=

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev only: include the OTP code in the /auth/otp/request response (ignored in production)
OTP_DEV_ECHO=true
# Only send SMS to these country prefixes (comma-separated). Empty = anywhere.
# Limits SMS toll fraud, e.g. +966,+971,+965,+973,+974,+968,+20,+962
SMS_ALLOWED_PREFIXES=

# Pluggable providers. "stub" needs no keys and is the default everywhere.
PAYMENT_PROVIDER=stub   # stub | moyasar
SMS_PROVIDER=stub       # stub | mobishastra
AI_PROVIDER=stub        # stub | claude
KYC_PROVIDER=stub       # stub
STORAGE_PROVIDER=local  # local | s3
PUSH_PROVIDER=stub      # stub | fcm

# Public base URL of this API (used in local-storage upload links)
PUBLIC_API_URL=http://localhost:3000

# SOS: every alert is texted to these numbers (comma-separated, E.164)
OPS_ALERT_PHONES=+966500000000

# --- Moyasar (PAYMENT_PROVIDER=moyasar) — dashboard.moyasar.com → Settings → API keys
# The publishable key is sent to the mobile app; the secret key never leaves the API.
MOYASAR_SECRET_KEY=sk_test_...
MOYASAR_PUBLISHABLE_KEY=pk_test_...
# Where Moyasar sends the browser after 3-D Secure (any page you control)
MOYASAR_CALLBACK_URL=https://your-domain.example/payments/callback
# Same value as the webhook "secret token" configured in the Moyasar dashboard,
# pointing at https://<api-host>/api/payments/webhooks/moyasar
MOYASAR_WEBHOOK_SECRET=
# MOYASAR_API_URL=https://api.moyasar.com/v1

# --- Mobishastra (SMS_PROVIDER=mobishastra) — mshastra.com account
MOBISHASTRA_USER=          # profile id, e.g. 200XXXXX
MOBISHASTRA_PASSWORD=
MOBISHASTRA_SENDER_ID=     # approved sender id (CITC-registered for Saudi numbers)
# MOBISHASTRA_API_URL=https://mshastra.com/sendurl.aspx

# --- Claude (AI_PROVIDER=claude) — console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low     # low | medium | high — chat is latency-sensitive

# Marketplace
PLATFORM_FEE_PERCENT=15
REVIEW_WINDOW_DAYS=30
DISPUTE_WINDOW_DAYS=7

# --- Document storage (STORAGE_PROVIDER=s3) — private bucket for license scans
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. me-south-1)
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
# MinIO: S3_ENDPOINT=http://localhost:9000, S3_FORCE_PATH_STYLE=true
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Local storage (STORAGE_PROVIDER=local, development only)
UPLOAD_DIR=uploads

# --- Push notifications (PUSH_PROVIDER=fcm) — Firebase console → Project settings →
# Service accounts → Generate new private key. Paste the JSON (or base64 of it) on one line.
FIREBASE_SERVICE_ACCOUNT=

# --- Admin portal (apps/admin) ---
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Show the demo admin credentials on the login page (local demos only)
NEXT_PUBLIC_DEMO_HINT=true

# --- Mobile (apps/mobile) — pass with --dart-define=API_URL=... ---
# Android emulator: http://10.0.2.2:3000/api  iOS simulator: http://localhost:3000/api
