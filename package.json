{
  "name": "tourguide-marketplace",
  "private": true,
  "description": "Certified tour guide marketplace — monorepo (mobile, admin, api)",
  "workspaces": [
    "services/api",
    "apps/admin"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "api:dev": "npm run start:dev -w services/api",
    "api:test": "npm test -w services/api",
    "api:migrate": "npm run migration:run -w services/api",
    "api:seed": "npm run seed -w services/api",
    "admin:dev": "npm run dev -w apps/admin"
  }
}
